generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Post {
  id          Int      @id @default(autoincrement())
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])

  @@index([name])
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String           @id @default(cuid())
  name          String?
  email         String?          @unique
  password      String?
  emailVerified DateTime?
  image         String?
  credits       Int              @default(300)
  accounts      Account[]
  chatWithtext  ChatSession[]
  chatWithPDFs  PdfChatSession[]
  posts         Post[]
  sessions      Session[]
}

model ChatSession {
  id        String    @id @default(cuid())
  userId    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  title     String?
  User      User?     @relation(fields: [userId], references: [id])
  messages  Message[]
}

model PdfChatSession {
  id            String         @id @default(cuid())
  title         String?
  userId        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  messages      Message[]
  User          User?          @relation(fields: [userId], references: [id])
  pdfs          PDF[]          @relation("PDFToPdfChatSession")
  documents     Document[]
  readinessRuns ReadinessRun[]
}

model PDF {
  id           String           @id @default(cuid())
  name         String
  url          String
  uploadedAt   DateTime         @default(now())
  chatSessions PdfChatSession[] @relation("PDFToPdfChatSession")
}

model Message {
  id               String          @id @default(cuid())
  chatSessionId    String?
  content          String
  createdAt        DateTime        @default(now())
  sender           SenderRole
  pdfChatSessionId String?
  chatSession      ChatSession?    @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  pdfChatSession   PdfChatSession? @relation(fields: [pdfChatSessionId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum SenderRole {
  user
  model
}

enum DocumentStatus {
  PROCESSING
  READY
  FAILED
}

model Document {
  id               String         @id @default(cuid())
  pdfChatSessionId String
  userId           String
  name             String
  url              String
  status           DocumentStatus @default(PROCESSING)
  pageCount        Int?
  error            String?
  createdAt        DateTime       @default(now())
  processedAt      DateTime?
  session          PdfChatSession @relation(fields: [pdfChatSessionId], references: [id], onDelete: Cascade)
  chunks           Chunk[]

  @@index([pdfChatSessionId])
  @@index([userId])
}

model Chunk {
  id         String   @id @default(cuid())
  documentId String
  page       Int
  section    String?
  chunkIndex Int
  content    String
  contextual String?
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

enum ReadinessRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ReadinessItemStatus {
  PRESENT
  PARTIAL
  MISSING
  NEEDS_REVIEW
}

/// One readiness assessment of a session's documents against a jurisdiction
/// blueprint. The run row, its item results, and its events together form the
/// durable audit trail; the LangGraph coordinator writes to them as it advances
/// through its nodes (load -> assess -> score -> explain -> finalize).
model ReadinessRun {
  id               String                @id @default(cuid())
  sessionId        String
  userId           String
  jurisdiction     String // e.g. "IN-CDSCO"
  blueprintId      String // e.g. "cdsco-ndct-2019"
  blueprintVersion String
  status           ReadinessRunStatus    @default(PENDING)
  score            Int? // 0-100, deterministic (null until scored)
  maxWeight        Int? // sum of item weights (score denominator)
  earnedWeight     Float? // weighted credit earned (score numerator)
  headline         String? // one-line "not ready: missing X, Y, Z"
  topFixes         Json? // ordered next actions (string[])
  categoryScores   Json? // per-category rollup for the dashboard chart
  error            String?
  createdAt        DateTime              @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  session          PdfChatSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  items            ReadinessItemResult[]
  events           ReadinessEvent[]

  @@index([sessionId])
  @@index([userId])
}

/// The assessor's verdict for a single blueprint item. `citations` are verified
/// against the retrieved chunks, so each carries a documentId + page the UI can
/// jump straight to.
model ReadinessItemResult {
  id             String              @id @default(cuid())
  runId          String
  itemKey        String
  category       String
  title          String
  status         ReadinessItemStatus
  weight         Int
  confidence     Float // 0-1 from the assessor
  rationale      String // grounded reasoning for the verdict
  recommendation String? // next action when not fully present
  citations      Json // [{ documentId, docName, page, snippet }]
  createdAt      DateTime            @default(now())
  run            ReadinessRun        @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

/// Append-only log of the coordinator's steps for one run - the audit trail a
/// regulated buyer can inspect to see exactly what the app did and when.
model ReadinessEvent {
  id        String       @id @default(cuid())
  runId     String
  node      String // coordinator node that emitted the event
  message   String
  data      Json?
  createdAt DateTime     @default(now())
  run       ReadinessRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}
